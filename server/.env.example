# iZiiServer Configuration Example (.env.example)
# Copy file này thành .env rồi chỉnh giá trị cho từng máy chạy server.
# KHÔNG commit file .env thật (đã có trong .gitignore).

# Định danh server — mỗi máy một giá trị khác nhau (server-m1 / server-m2 / server-cr)
IZIIAPP_SERVER_ID=server-m1
IZIIAPP_ZONE=M1

# Peer tĩnh, phân tách bằng dấu phẩy. Để trống cũng được nếu chỉ dựa vào mDNS.
IZIIAPP_PEERS=http://192.168.1.11:8080,http://192.168.1.12:8080

# Chu kỳ polling đồng bộ giữa các server (giây)
IZIIAPP_SYNC_INTERVAL_SECONDS=45

# ── Ba phạm vi bí mật TÁCH BIỆT (B1) ─────────────────────────────────────────
# Trước đây dùng chung một chuỗi, nghĩa là thiết bị nào biết token đồng bộ cũng
# gọi được /admin/reset (xoá sạch DB) và /admin/config (ghi đè .env). Nay tách:
#
#   SERVER_SECRET → /peer-sync/*  (server ↔ server)
#   ADMIN_SECRET  → /admin/*      (quản trị — ĐỪNG đưa cho máy công nhân)
#   device token  → /sync/*       (cấp riêng từng máy qua QR/NFC)

# Secret cho /peer-sync/* — PHẢI GIỐNG NHAU trên cả 3 server.
IZIIAPP_SERVER_SECRET=change_me_to_secure_secret_token

# Secret cho /admin/* — chỉ máy quản lý mới có.
# Bỏ trống thì tạm dùng chung SERVER_SECRET (có cảnh báo lúc khởi động),
# nhưng nên đặt riêng để một máy công nhân bị mất không kéo theo cả hệ thống.
IZIIAPP_ADMIN_SECRET=change_me_to_a_DIFFERENT_admin_token

# Bật thì /sync/* bắt buộc có X-iZii-Device-Token hợp lệ.
# ⚠️ CHỈ bật sau khi TẤT CẢ thiết bị đã đăng ký xong, nếu không cả nhà máy
#    mất kết nối cùng lúc.
IZIIAPP_REQUIRE_DEVICE_TOKEN=false

# Thời gian sống của vé mời đăng ký thiết bị (giây). Mặc định 600 = 10 phút.
# Tăng lên nếu ghi thẻ NFC dán tường, ví dụ 3600 cho một ca.
IZIIAPP_ENROLLMENT_TOKEN_TTL=600

# ⓘ Ba khoá trên sửa được từ app: Settings → Cấu hình Server (.env)
#   → nhóm "Bảo mật & Phân quyền". Nhớ khởi động lại server sau khi sửa.

# Secret cho WebSocket /chat. Client gửi qua ?token=... hoặc header
# X-iZii-WS-Token. BẮT BUỘC phải có token hợp lệ mới kết nối được.
# Nếu để trống, server sẽ dùng IZIIAPP_SERVER_SECRET thay thế.
# Nếu CẢ HAI đều trống, /chat sẽ TỪ CHỐI mọi kết nối.
IZIIAPP_WS_SECRET=change_me_to_secure_ws_token

# Tuỳ chọn: ghi đè đường dẫn file SQLite
# IZIIAPP_SERVER_DB_PATH=C:/path/to/iziiapp.db


# ══════════════════════════════════════════════════════════════════════════════
#  6.3 — Backend cơ sở dữ liệu
# ══════════════════════════════════════════════════════════════════════════════
# sqlite   : mặc định, chạy biên, không cần cài gì thêm.
# postgres : khi có nhiều adapter ghi song song (SAP/OPC/Historian) hoặc nhiều
#            site. SQLite chỉ cho MỘT writer nên sẽ thành nút cổ chai.
#
# Chuyển đổi: chạy `python migrate_to_postgres.py` TRƯỚC, kiểm tra số dòng,
# rồi mới đổi dòng dưới đây và khởi động lại.
IZIIAPP_DB_BACKEND=sqlite

# Bắt buộc khi backend=postgres. Cài: pip install "psycopg[binary,pool]"
# IZIIAPP_PG_DSN=postgresql://izii:matkhau@192.168.1.50:5432/iziiapp
# IZIIAPP_PG_POOL_MIN=1
# IZIIAPP_PG_POOL_MAX=10


# ══════════════════════════════════════════════════════════════════════════════
#  6.4 — TLS / mTLS cho peer-sync
# ══════════════════════════════════════════════════════════════════════════════
# Sinh chứng chỉ: .\gen_dev_certs.ps1
#
# Bật DẦN theo 3 bước, mỗi bước bật ĐỒNG LOẠT trên cả 3 server:
#   Bước 1 — chỉ mã hoá: khai CERT + KEY
#   Bước 2 — thêm mTLS : khai CA + REQUIRE_CLIENT_CERT=true
#   Bước 3 — siết CN   : khai ALLOWED_PEER_CNS
#
# ⚠️ Bật TLS thì IZIIAPP_PEERS phải đổi sang https://. Ghép http với https sẽ
#    làm peer-sync hỏng ở bước bắt tay mà không có lỗi rõ ràng.
# ⚠️ Thêm certs/ vào .gitignore — file .key là khoá bí mật.
#
# IZIIAPP_TLS_CERT_FILE=certs/server-m1.crt
# IZIIAPP_TLS_KEY_FILE=certs/server-m1.key
# IZIIAPP_TLS_CA_FILE=certs/izii-ca.crt
# IZIIAPP_TLS_REQUIRE_CLIENT_CERT=true
# IZIIAPP_TLS_ALLOWED_PEER_CNS=server-m1,server-m2,server-cr


# ══════════════════════════════════════════════════════════════════════════════
#  6.4 — OAuth 2.0 cho chiều RA (iZii gọi SAP / ERP)
# ══════════════════════════════════════════════════════════════════════════════
# Khác với mTLS ở trên vốn bảo vệ chiều VÀO. SAP Event Mesh và OData của SAP
# Gateway đều dùng OAuth 2.0 client credentials.
# Bỏ trống = chưa tích hợp ERP, server chạy bình thường.
#
# IZIIAPP_OAUTH_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
# IZIIAPP_OAUTH_CLIENT_ID=sb-xxxxxxxx
# IZIIAPP_OAUTH_CLIENT_SECRET=
# IZIIAPP_OAUTH_SCOPE=
