# iZiiServer Configuration Example (.env.example)
# Copy file này thành .env rồi chỉnh giá trị cho từng máy chạy server.
# KHÔNG commit file .env thật (đã có trong .gitignore).

# Định danh server — mỗi máy một giá trị khác nhau (server-m1 / server-m2 / server-cr)
IZIIAPP_SERVER_ID=server-m1
IZIIAPP_ZONE=M1

# Peer tĩnh, phân tách bằng dấu phẩy. Để trống cũng được nếu chỉ dựa vào mDNS.
IZIIAPP_PEERS=http://192.168.1.11:8080,http://192.168.1.12:8080

# Chu kỳ polling đồng bộ giữa các server (giây)
IZIIAPP_SYNC_INTERVAL_SECONDS=45

# Secret dùng chung cho /peer-sync/* (header X-iZii-Server-Token).
# PHẢI GIỐNG NHAU trên cả 3 server thì mesh mới sync được.
# Bỏ trống = tắt xác thực server-to-server (không khuyến nghị).
IZIIAPP_SERVER_SECRET=change_me_to_secure_secret_token

# Secret cho WebSocket /chat. Client gửi qua ?token=... hoặc header
# X-iZii-WS-Token. BẮT BUỘC phải có token hợp lệ mới kết nối được.
# Nếu để trống, server sẽ dùng IZIIAPP_SERVER_SECRET thay thế.
# Nếu CẢ HAI đều trống, /chat sẽ TỪ CHỐI mọi kết nối.
IZIIAPP_WS_SECRET=change_me_to_secure_ws_token

# Tuỳ chọn: ghi đè đường dẫn file SQLite
# IZIIAPP_SERVER_DB_PATH=C:/path/to/iziiapp.db
